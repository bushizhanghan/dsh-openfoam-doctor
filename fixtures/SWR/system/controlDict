FoamFile
{
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     foamRun;

solver          incompressibleFluid;

startFrom       startTime;

startTime       0;

stopAt          endTime;

endTime         3000;

deltaT          1;

writeControl    timeStep;

writeInterval   200;

purgeWrite      0;

writeFormat     ascii;

writePrecision  6;

writeCompression off;

timeFormat      general;

timePrecision   6;

runTimeModifiable true;

functions
{
    // 墙后 1 / 3 / 6 m 处、车道高度附近布探针，采 U 看尾流恢复
    probes
    {
        type            probes;
        libs            (fieldFunctionObjects);
        fields          (U);
        probeLocations
        (
            (1 0.5 0)
            (3 0.5 0)
            (6 0.5 0)
            (1 1.2 0)
            (3 1.2 0)
            (6 1.2 0)
        );
        writeControl    timeStep;
        writeInterval   200;
    }
}

